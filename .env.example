# Postgres local. Cambiar usuario/password por los de tu instalación.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/gestool?schema=public"

# Secreto de NextAuth. Generar uno nuevo con: pnpm dlx auth secret
AUTH_SECRET=""

# Credenciales del admin inicial que crea `pnpm db:seed`
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_PASSWORD="admin123"
