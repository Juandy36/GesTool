// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  BODEGUERO
}

model Usuario {
  id                  String   @id @default(cuid())
  usuario             String   @unique
  nombre              String
  passwordHash        String
  rol                 Rol      @default(BODEGUERO)
  debeCambiarPassword Boolean  @default(true)
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now())
  actualizadoEn       DateTime @updatedAt
  entradas            Entrada[]
  salidas             Salida[]
  auditorias          Auditoria[]
}

enum TipoItem {
  MATERIAL
  HERRAMIENTA
}

model Categoria {
  id            String   @id @default(cuid())
  nombre        String   @unique
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  items         Item[]
}

/// El `stock` nunca se edita a mano: solo cambia al registrar una Entrada o
/// una Salida. Dar de baja es lógico (`activo = false`), nunca un delete.
model Item {
  id            String    @id @default(cuid())
  codigo        String    @unique
  nombre        String
  tipo          TipoItem  @default(MATERIAL)
  categoriaId   String
  categoria     Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  stock         Int       @default(0)
  umbralMinimo  Int       @default(0)
  umbralCritico Int       @default(0)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  entradas      Entrada[]
  salidas       Salida[]

  @@index([categoriaId])
}

/// Libros append-only: un movimiento no se edita ni se borra. El `stock` del
/// ítem se mueve en la misma transacción que crea el registro.
model Entrada {
  id           String   @id @default(cuid())
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  cantidad     Int
  fecha        DateTime
  proveedor    String
  quienEntrega String
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn     DateTime @default(now())

  @@index([itemId])
  @@index([fecha])
}

model Salida {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  cantidad   Int
  fecha      DateTime
  trabajador String
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn   DateTime @default(now())

  @@index([itemId])
  @@index([fecha])
}

enum AccionAuditoria {
  LOGIN
  LOGIN_FALLIDO
  CAMBIO_PASSWORD
  ITEM_CREADO
  ITEM_EDITADO
  ITEM_BAJA
  CATEGORIA_CREADA
  CATEGORIA_RENOMBRADA
  CATEGORIA_ELIMINADA
  ENTRADA_REGISTRADA
  SALIDA_REGISTRADA
  USUARIO_CREADO
  USUARIO_PASSWORD_RESET
}

/// Append-only igual que Entrada/Salida: se escribe y no se toca mas.
model Auditoria {
  id        String          @id @default(cuid())
  accion    AccionAuditoria
  /// Nullable a proposito: un LOGIN_FALLIDO con usuario inexistente no tiene a quien apuntar.
  usuarioId String?
  usuario   Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  /// Linea legible, tal como va a salir en la celda del Excel.
  detalle   String
  creadoEn  DateTime        @default(now())

  @@index([usuarioId])
  @@index([creadoEn])
}
